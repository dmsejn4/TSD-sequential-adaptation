#2. Fisher 계산 함수 정의
def compute_fisher(ckpt_path, arch_yaml, data_yaml, n_samples=500, imgsz=640):
    model = YOLO(arch_yaml)
    model.load(ckpt_path)
    det = model.model.cuda()

    theta_star = {n: p.detach().clone() for n, p in det.named_parameters()}
    fisher     = {n: torch.zeros_like(p) for n, p in det.named_parameters() if p.requires_grad}

    # loss 계산에 필요한 하이퍼파라미터 부착
    det.args = get_cfg(DEFAULT_CFG)
    det.args.imgsz = imgsz

    det.train()
    for m in det.modules():                      # BN 통계 고정
        if isinstance(m, torch.nn.BatchNorm2d):
            m.eval()

    import yaml
    data = yaml.safe_load(open(data_yaml))
    data['nc'] = len(data['names'])
    dataset = build_yolo_dataset(det.args, data['train'], 1, data, mode='val', rect=False)
    loader  = build_dataloader(dataset, batch=1, workers=0, shuffle=False)

    n_batches = 0
    for batch in loader:
        if n_batches >= n_samples:
            break
        batch['img'] = batch['img'].cuda().float() / 255
        for k in ('batch_idx', 'cls', 'bboxes'):
            batch[k] = batch[k].cuda()

        det.zero_grad(set_to_none=True)
        loss, _ = det.loss(batch)
        loss.backward()

        for n, p in det.named_parameters():
            if p.grad is not None and n in fisher:
                fisher[n] += p.grad.detach() ** 2
        n_batches += 1

    fisher = {n: f / n_batches for n, f in fisher.items()}
    print(f"Fisher 계산 완료: {n_batches} batches, {len(fisher)} tensors")
    det.zero_grad(set_to_none=True)
    return fisher, theta_star

