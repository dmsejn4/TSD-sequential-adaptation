# ── 3) 콜백으로 trainer.model에 EWC 부착 ──────────────────────────
import types

BN_BEFORE = {}

def attach_ewc(trainer):
    m = trainer.model                      # 실제 학습되는 모델
    dev = next(m.parameters()).device
    F = {n: f.to(dev) for n, f in FISHER_CPU.items()}
    T = {n: t.to(dev) for n, t in THETA_CPU.items()}

    BN_BEFORE.clear()
    BN_BEFORE.update({n: b.clone() for n, b in m.named_buffers() if 'running_' in n})

    applied = [n for n, p in m.named_parameters()
               if n in F and p.shape == F[n].shape
               and n in T and p.shape == T[n].shape]
    skipped = [n for n in F if n not in applied]
    print(f"[EWC] 부착 완료 (LAM={LAM}): 적용 {len(applied)}, 제외 {len(skipped)}")
    print(f"[EWC] 제외 key: {skipped}")
    print(f"[EWC] 초기 penalty: {ewc_penalty(m, F, T, LAM).item():.6f}")   # 0이어야 정상

    orig = m.loss
    step = [0]
    def loss_with_ewc(self, batch, preds=None):
        total, items = orig(batch, preds)
        pen = ewc_penalty(self, F, T, LAM) * batch['img'].shape[0]   # loss 스케일 맞춤
        step[0] += 1
        if step[0] % 100 == 0:
            print(f"[step {step[0]}] det={total.item():.2f}  ewc={pen.item():.2f}")
        return total + pen, items          # items는 3원소 유지
    m.loss = types.MethodType(loss_with_ewc, m)

model.add_callback("on_train_start", attach_ewc)

