# 3) loss 래핑
orig_loss = det_model.loss
_step = [0]
def loss_with_ewc(self, batch, preds=None):
    total, items = orig_loss(batch, preds)
    pen = ewc_penalty(self, FISHER, THETA, LAM)
    _step[0] += 1
    if _step[0] % 100 == 0:
        print(f"[step {_step[0]}] det_loss={total.item():.3f}  ewc_pen={pen.item():.3f}")
    return total + pen, items
det_model.loss = types.MethodType(loss_with_ewc, det_model)

before = {n: b.clone() for n, b in det_model.named_buffers() if 'running_' in n}

